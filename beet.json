{
    "name": "ProjectFight",
    "description": "WIP",
    "version": "v0.0.1",
    "author": "Trplnr",
    "minecraft": "1.21",
    "data_pack": {
      "load": ["./libs/*"]
    },
    "resource_pack": {
      "load": ["./libs/*"]
    },
    "pipeline": [
      {
        "minecraft": "1.21",
        "require": ["bolt", "bolt_expressions"],
        "data_pack": {
          "load": ["./src"],
          "min_format": [88, 0],
          "max_format": [88, 0],
          "filter": {
            "block": [
              { "namespace": "minecraft", "path": "recipe/.*" },
              { "namespace": "minecraft", "path": "advancement/.*" }
            ]
          }
        },
        "resource_pack": {
          "load": ["./src"],
          "zipped": true,
          "min_format": [69, 0],
          "max_format": [69, 0]
        },
        "pipeline": ["mecha"],
        "meta": {
          "bolt": {"entrypoint": "projectfight:*"}
        }
      }
    ],
    "output": "./build"
}