use ::java::world::component::item::ItemUseAnimation
use ::java::world::component::item::ConsumeEffect
use ::java::data::util::SoundEventRef
use super::types::Vector3
use super::types::CoordinateMode

struct UseableComponent {
    /// How long it takes to use the item in seconds. Defaults to `0`
    duration?: float @ 0..,
    /// Using animation. Defaults to `block`
    animation?: ItemUseAnimation,
    /// Sound to play while using. Defaults to `minecraft:intentionally_empty`
    sound?: SoundEventRef,
    /// Whether to show the item particles while using or not. Defaults to `false`
    show_particles?: boolean,
    /// Whether the player is allowed to sprint or not. Defaults to `true`
    can_sprint?: boolean,
    /// Speed to multiply the player's movement speed whilst using the item. Defaults to `1`
    speed_multipler?: float @ 0..1,
    /// See on_consume_effects in https://minecraft.wiki/w/Data_component_format#consumable
    on_use_effects?: [ConsumeEffect],
    /// Function to run when the item has been used.
    on_use_function?: #[id="function"] string
}

struct WeaponComponent {
    spawn_position: Vector3,
    initial_velocity?: struct {
        coordinate_mode?: CoordinateMode,
        velocity?: Vector3
    },
    projectile: #[id="pf:pf_projectile"] string
}

struct OnTickFunctionComponent {
    function: #[id="function"] string,
    args: struct {
        data_source: #[id="storage"] string,
        path: #[nbt_path] string
    }
}

struct DieOnRandomChanceComponent {
    chance: float @ 0..1
}