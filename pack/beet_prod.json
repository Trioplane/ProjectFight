{
    "author": "Trplnr",
    "name": "ProjectFight",
    "description": "A fast chaotic PVP game inspired by RUNNING FROM THE INTERNET",
    "version": "0.1.0",
    "minecraft": "26.3",
    "data_pack": {
        "load": ["src"],
        "min_format": [121,1],
        "max_format": [121,1]
    },
    "resource_pack": {
        "load": ["src"],
        "min_format": [97,1],
        "max_format": [97,1]
    },
    "pipeline": ["plugins.load_third_party", "mecha"],
    "require": [
        "projectfight_sdk",
        "bolt",
        "bolt_expressions",
        "bolt_native_macros"
    ],
    "meta": {
        "bolt": {
            "entrypoint": "pf:main"
        },
        "pf_environment": "production"
    },
    "output": ".build"
}