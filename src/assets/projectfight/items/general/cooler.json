{
    "model": {
        "type": "select",
        "property": "custom_model_data",
        "index": 0,
        "fallback": {
            "type": "model",
            "model": "projectfight:item/general/cooler_closed"
        },
        "cases": [
            { "when": "closed", "model": { "type": "model", "model": "projectfight:item/general/cooler_closed" } },
            { "when": "empty", "model": { "type": "model", "model": "projectfight:item/general/cooler_empty" } },
            { "when": "full", "model": { "type": "model", "model": "projectfight:item/general/cooler_full" } }
        ]
    }
}