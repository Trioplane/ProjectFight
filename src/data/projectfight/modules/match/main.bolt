function ~/init:
    function projectfight:match/loadout/init

    scoreboard objectives add projectfight.match dummy

    scoreboard players add .active projectfight.match 0
    scoreboard players add .time_left projectfight.match 0
    scoreboard players add .dice_timer projectfight.match 0

    # remove this from match code once done with temp game loop
    scoreboard players add .next_match_timer projectfight.match 0
    scoreboard players add .stop_game_loop projectfight.match 0

function ~/tick:
    execute if score .active projectfight.match matches 0 unless score .stop_game_loop projectfight.match matches 1:
        scoreboard players remove .next_match_timer projectfight.match 1
        execute if score .next_match_timer projectfight.match matches 100:
            tellraw @a {text:"Match starts in 5 seconds.",color:"gray"}
            execute as @a at @s run playsound minecraft:block.note_block.pling master
        execute if score .next_match_timer projectfight.match matches 20:
            title @a times 0.8s 5s 0.8s
            title @a title {text:"\uE000",font:"projectfight:scrfx/intro45"}
            execute as @a at @s run playsound minecraft:block.beacon.activate master
        execute if score .next_match_timer projectfight.match matches ..0 positioned 0.0 0.0 0.0 run function projectfight:match/main/start


    execute if score .active projectfight.match matches 1 unless score .stop_game_loop projectfight.match matches 1:
        function projectfight:match/dice/tick

        execute if score .dice_timer projectfight.match matches 1.. run scoreboard players remove .dice_timer projectfight.match 1
        execute unless score .dice_timer projectfight.match matches 1..:
            execute
                at @e[type=marker,tag=projectfight.dice.spawner,sort=random,limit=3]
                positioned ~ ~1.25 ~
                unless entity @n[type=item_display,tag=projectfight.dice,distance=..1]:
                    function projectfight:match/dice/spawn
            scoreboard players set .dice_timer projectfight.match 20
        
        scoreboard players remove .time_left projectfight.match 1

        execute if score .time_left projectfight.match matches 1200:
            tellraw @a {text:"Match ends in 1 minute.",color:"gray"}
            execute as @a at @s run playsound minecraft:block.note_block.pling master
        execute if score .time_left projectfight.match matches 600:
            tellraw @a {text:"Match ends in 30 seconds.",color:"gray"}
            execute as @a at @s run playsound minecraft:block.note_block.pling master
        execute if score .time_left projectfight.match matches 100:
            tellraw @a {text:"Match ends in 5 seconds.",color:"gray"}
            execute as @a at @s run playsound minecraft:block.note_block.pling master
        
        execute if score .time_left projectfight.match matches 20:
            title @a times 0.8s 5s 0.8s
            title @a title {text:"\uE000",font:"projectfight:scrfx/intro45"}
            execute as @a run function projectfight:player/movement/knockback/enable
            execute as @a at @s run playsound minecraft:block.conduit.deactivate master
            execute as @a at @s run playsound minecraft:block.beacon.deactivate master
        execute if score .time_left projectfight.match matches ..0 positioned 0.0 0.0 0.0 run function projectfight:match/main/end

# VERY TEMPORARY WIP BASIC GAME LOOP

function ~/start:
    tag @a add projectfight.player.playing
    function ~/../clear_map
    execute positioned 0.0 0.0 0.0 run function ~/../place_walls
    execute positioned 0.0 0.0 0.0 run function ~/../place_map

    data modify storage projectfight:match loadout.items set value ["crate","firework","landmine","banana_peel","wet_floor_sign"]

    gamemode adventure @a[tag=projectfight.player.playing]
    execute as @a[tag=projectfight.player.playing] run tp @s @n[type=marker,tag=projectfight.match.spawn,sort=random]

    scoreboard players set .active projectfight.match 1
    scoreboard players set .time_left projectfight.match 6000

function ~/end:
    tag @a remove projectfight.player.playing
    function ~/../clear_map
    kill @e[tag=projectfight.items]
    execute positioned 0.0 0.0 0.0 run function ~/../place_walls
    execute positioned 0.0 0.0 0.0 run function ~/../place_lobby
    scoreboard players set .active projectfight.match 0
    scoreboard players set .next_match_timer projectfight.match 400
    tp @a 50 10 50
    clear @a
    tellraw @a {text:"Next match starts in 20 seconds.",color:"gray"}

function ~/clear_map:
    fill -1 -1 -1 101 101 101 air strict
    kill @e[tag=projectfight.dice.spawner]
    kill @e[tag=projectfight.match.spawn]
    kill @e[tag=projectfight.dice]
    kill @e[tag=projectfight.map.display]

function ~/place_walls:
    fill -1 -50 -1 100 100 100 barrier hollow

function ~/place_lobby:
    place template projectfight:lobby 0 0 0 none none 1 0 strict

function ~/place_map:
    place template projectfight:maps/islands 0 0 0 none none 1 0 strict